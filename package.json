{
  "name": "urja-meter-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js | pino-pretty",
    "start": "node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture-fixtures": "node --env-file=.env scripts/capture-fixtures.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "env-schema": "8.0.1",
    "fastify": "5.12.7",
    "p-limit": "7.3.3",
    "tough-cookie": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-n": "18.5.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "undici": "7.30.1"
  }
}
